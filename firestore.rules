rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function mainOwner() { return signed() && request.auth.token.email == 'alanjavier467@gmail.com'; }
    function isOwner() {
      return mainOwner()
        || (signed()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dueño');
    }
    function isStaff() {
      return signed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function member() { return isOwner() || isStaff(); }

    match /users/{uid} {
      allow read: if isOwner() || (signed() && request.auth.uid == uid);
      allow create: if isOwner()
        || (signed() && request.auth.uid == uid
            && request.resource.data.active == false
            && request.resource.data.role == 'empleado');
      allow update, delete: if isOwner();
    }
    match /carros/{id} {
      allow read: if member();
      allow write: if isOwner();
    }
    match /privado/{id} {
      allow read, write: if isOwner();
    }
    match /estado/{id} {
      allow read: if member();
      allow create, update: if member();
      allow delete: if isOwner();
    }
    match /precios/{id} {
      allow read: if member();
      allow write: if isOwner();
    }
    match /alternos/{id} {
      allow read, write: if member();
    }
    match /ventas/{id} {
      allow read: if isOwner() || (isStaff() && resource.data.by == request.auth.uid);
      allow create: if isOwner()
        || (isStaff()
            && request.resource.data.by == request.auth.uid
            && request.resource.data.desc <= request.resource.data.sub * 0.10 + 0.01);
      allow update, delete: if isOwner();
    }
    match /fotos/{id} {
      allow get: if true;
      allow list, create: if member();
      allow update, delete: if isOwner() || (member() && resource.data.by == request.auth.uid);
    }
    match /fotosfull/{id} {
      allow get: if true;
      allow list, create: if member();
      allow update, delete: if isOwner() || (member() && get(/databases/$(database)/documents/fotos/$(id)).data.by == request.auth.uid);
    }
    match /extras/{id} {
      allow read, create, update: if member();
      allow delete: if isOwner();
    }
    match /config/{id} {
      allow read: if member();
      allow write: if isOwner();
    }
    match /vista360/{id} {
      allow read: if member();
      allow write: if isOwner();
    }
    match /clientes/{uid} {
      // el vendedor abre un cliente o busca por teléfono/usuario (máx. 5 resultados); la lista completa solo el creador
      allow get: if member() || (signed() && request.auth.uid == uid);
      allow list: if isOwner() || (isStaff() && request.query.limit != null && request.query.limit <= 5);
      // el cliente se registra sin puntos ni compras, y después solo cambia su nombre y teléfono
      allow create: if (signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['user','name','tel','email','created']))
        // el creador o un vendedor registra a un cliente en el mostrador, siempre con 0 puntos
        || (member() && request.resource.data.by == request.auth.uid
            && request.resource.data.keys().hasOnly(['name','tel','color','ver','desc','created','by','byName','puntos','compras'])
            && request.resource.data.puntos == 0 && request.resource.data.compras == 0
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80);
      allow update: if isOwner()
        || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['puntos','compras','ultimaCompra']))
        || (signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','tel']));
      allow delete: if isOwner();
    }
    match /solicitudes/{id} {
      allow create: if signed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','user','name','tel','pay','coment','total','date','items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.coment is string && request.resource.data.coment.size() <= 600;
      allow read: if isOwner() || (signed() && resource.data.uid == request.auth.uid);
      allow update, delete: if isOwner();
    }
    match /cortes/{id} {
      allow read: if isOwner() || (isStaff() && resource.data.by == request.auth.uid);
      allow create: if member() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isOwner();
    }
    match /resenas/{id} {
      // cualquiera ve las que no están ocultas; el creador ve todas
      allow read: if isOwner() || resource.data.oculta == false;
      // solo se puede opinar con el enlace de una venta real, una sola vez
      allow create: if exists(/databases/$(database)/documents/ventas/$(id))
        && get(/databases/$(database)/documents/ventas/$(id)).data.get('cancelada', false) == false
        && request.resource.data.keys().hasOnly(['estrellas','texto','nombre','date','oculta'])
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 400
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 40
        && request.resource.data.oculta == false;
      allow update, delete: if isOwner();
    }
    // lista ligera de fotos (sin imagen): la app la lee en una sola lectura y baja cada miniatura al verla
    match /indice/{id} {
      allow read, create, update: if member();
      allow delete: if isOwner();
    }
    // historial: cada miembro anota sus propios movimientos; solo el creador los lee; nadie los cambia
    match /movimientos/{id} {
      allow read: if isOwner();
      allow create: if member() && request.resource.data.by == request.auth.uid;
    }
    match /publico/{id} {
      allow read: if true;
      // la tienda: solo apps que mandan la lista de carros pueden escribirla (las muy viejas no)
      // el vendedor no puede cambiar el WhatsApp, nombre, dirección ni pie de la tienda: eso solo lo pone el creador
      allow write: if isOwner() && (id != 'inventario' || (request.resource.data.cars is list && request.resource.data.cars.size() > 0));
      allow create, update: if isStaff() && id == 'inventario'
        && request.resource.data.cars is list && request.resource.data.cars.size() > 0
        && resource != null
        && request.resource.data.get('wa','') == resource.data.get('wa','')
        && request.resource.data.get('nombre','') == resource.data.get('nombre','')
        && request.resource.data.get('dir','') == resource.data.get('dir','')
        && request.resource.data.get('pie','') == resource.data.get('pie','');
    }
  }
}
